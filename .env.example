# Copy to .env.local and fill in as features land. Every variable is optional today;
# src/lib/env.ts validates whatever is set.

# Prisma (roadmap item 2). SQLite for local development.
DATABASE_URL="file:./dev.db"

# NextAuth (roadmap item 3). Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth client (roadmap item 3). Both or neither.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
