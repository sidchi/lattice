# Copy to .env.local. Every variable is optional: without the Google ones the app runs with
# sign-in turned off. src/lib/env.ts validates whatever is set.

# Prisma (roadmap item 2). SQLite for local development.
DATABASE_URL="file:./dev.db"

# NextAuth. Encrypts session cookies; required once Google sign-in is configured.
# Generate one with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth web client. Both or neither. Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Answer feedback (roadmap item 6). Leave LLM_PROVIDER unset to use the offline heuristic
# evaluator (no network, no key). "anthropic" uses the Messages API; "openai" uses Chat
# Completions and works with any OpenAI-compatible server via LLM_BASE_URL (e.g. Ollama at
# http://localhost:11434/v1, where any non-empty key is accepted).
LLM_PROVIDER=""
LLM_API_KEY=""
LLM_MODEL=""
LLM_BASE_URL=""
